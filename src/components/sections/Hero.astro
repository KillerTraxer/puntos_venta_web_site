---
import Container from '../common/Container.astro';
import Button from '../common/Button.astro';
---

<section class="bg-gradient-to-br from-primary-500/10 to-primary-700/10 pt-20 pb-16 md:pt-24 md:pb-24">
  <Container>
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
      <div class="w-full lg:w-1/2 text-center lg:text-left">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-neutral-900 leading-tight mb-6">
          Streamline Your Business with Modern <span class="text-primary-500">POS Solutions</span>
        </h1>
        <p class="text-xl text-neutral-600 mb-8 max-w-2xl mx-auto lg:mx-0">
          Powerful, intuitive and affordable point-of-sale system that helps you manage inventory, track sales, and delight customers - all in one place.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <Button href="/pricing" variant="primary" size="lg">View Pricing Plans</Button>
          <Button 
            variant="outline" 
            size="lg"
            id="watch-demo-btn"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347a1.125 1.125 0 0 1-1.667-.986V5.653Z" />
            </svg>
            Watch Demo
          </Button>
        </div>
        <div class="mt-8 flex items-center justify-center lg:justify-start">
          <div class="flex -space-x-2">
            <img src="https://images.pexels.com/photos/614810/pexels-photo-614810.jpeg?auto=compress&cs=tinysrgb&w=60&h=60&dpr=1" class="w-10 h-10 rounded-full border-2 border-white" alt="Customer" />
            <img src="https://images.pexels.com/photos/2379004/pexels-photo-2379004.jpeg?auto=compress&cs=tinysrgb&w=60&h=60&dpr=1" class="w-10 h-10 rounded-full border-2 border-white" alt="Customer" />
            <img src="https://images.pexels.com/photos/1222271/pexels-photo-1222271.jpeg?auto=compress&cs=tinysrgb&w=60&h=60&dpr=1" class="w-10 h-10 rounded-full border-2 border-white" alt="Customer" />
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-neutral-900">Trusted by 5,000+ businesses</p>
            <div class="flex items-center mt-1">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-yellow-400">
                <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-yellow-400">
                <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-yellow-400">
                <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-yellow-400">
                <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-yellow-400">
                <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
              </svg>
              <span class="ml-1 text-sm text-neutral-600">4.9/5 on Trustpilot</span>
            </div>
          </div>
        </div>
      </div>
      
      <div class="w-full lg:w-1/2 relative">
        <div class="relative rounded-xl overflow-hidden shadow-2xl bg-white p-2">
          <img 
            src="https://images.pexels.com/photos/7191160/pexels-photo-7191160.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" 
            alt="POS System Demo" 
            class="rounded-lg w-full"
            loading="eager"
          />
          <div class="absolute inset-0 flex items-center justify-center">
            <button 
              id="play-demo-btn"
              class="w-16 h-16 rounded-full bg-white/90 flex items-center justify-center shadow-lg hover:bg-white transition-colors duration-300"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-8 h-8 text-primary-500 ml-1">
                <path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.714 1.295 2.573 0 3.287L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </Container>

  <!-- Video Modal -->
  <div id="video-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/75"></div>
    <div class="relative z-10 w-full h-full flex items-center justify-center p-4">
      <div class="bg-black rounded-xl overflow-hidden w-full max-w-4xl">
        <div class="relative pt-[56.25%]">
          <iframe
            id="youtube-player"
            class="absolute inset-0 w-full h-full"
            src=""
            title="YouTube video player"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
      <button id="close-modal" class="absolute top-4 right-4 text-white hover:text-gray-300">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('video-modal');
    const iframe = document.getElementById('youtube-player');
    const playBtn = document.getElementById('play-demo-btn');
    const watchBtn = document.getElementById('watch-demo-btn');
    const closeBtn = document.getElementById('close-modal');
    
    function openModal() {
      if (modal && iframe) {
        modal.classList.remove('hidden');
        iframe.src = 'https://www.youtube.com/embed/yKCAna4SrOA?autoplay=1';
        document.body.style.overflow = 'hidden';
      }
    }
    
    function closeModal() {
      if (modal && iframe) {
        modal.classList.add('hidden');
        iframe.src = '';
        document.body.style.overflow = '';
      }
    }
    
    if (playBtn) {
      playBtn.addEventListener('click', openModal);
    }
    
    if (watchBtn) {
      watchBtn.addEventListener('click', openModal);
    }
    
    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }
    
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });
    }
    
    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeModal();
      }
    });
  });
</script>