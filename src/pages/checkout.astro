---
import Layout from '../layouts/Layout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';

// Get URL parameters
const { plan = 'starter', billing = 'monthly' } = Astro.url.searchParams;

// Define plan details
const plans = {
  starter: {
    name: 'Starter',
    monthlyPrice: 29,
    annualPrice: 276,
    features: [
      '1 POS Terminal',
      'Basic Inventory Management',
      'Email Support',
      'Sales Reports'
    ]
  },
  professional: {
    name: 'Professional',
    monthlyPrice: 79,
    annualPrice: 756,
    features: [
      '3 POS Terminals',
      'Advanced Inventory Management',
      'Customer Management',
      'Priority Email & Chat Support',
      'Advanced Analytics & Reports'
    ]
  },
  enterprise: {
    name: 'Enterprise',
    monthlyPrice: 149,
    annualPrice: 1428,
    features: [
      'Unlimited POS Terminals',
      'Enterprise Inventory Management',
      'Custom Integrations',
      '24/7 Priority Support',
      'Dedicated Account Manager'
    ]
  }
};

// Get the selected plan
const selectedPlan = plans[plan] || plans.starter;
const isAnnual = billing === 'annual';
const price = isAnnual ? selectedPlan.annualPrice : selectedPlan.monthlyPrice;
const interval = isAnnual ? 'year' : 'month';

// Meta information
const title = `Checkout - ${selectedPlan.name} Plan | POSPro`;
const description = `Complete your purchase of the ${selectedPlan.name} plan and start streamlining your business operations today.`;
---

<Layout title={title} description={description}>
  <div class="py-12 md:py-20 bg-gray-50">
    <Container narrow={true}>
      <div class="max-w-3xl mx-auto">
        <h1 class="text-3xl md:text-4xl font-bold text-center mb-8">Complete Your Purchase</h1>
        
        <div class="bg-white rounded-xl shadow-lg overflow-hidden">
          <div class="bg-primary-500 p-6 text-white">
            <h2 class="text-xl font-semibold">{selectedPlan.name} Plan - {isAnnual ? 'Annual' : 'Monthly'}</h2>
            <div class="flex items-baseline mt-2">
              <span class="text-3xl font-bold">${isAnnual ? (selectedPlan.annualPrice / 12).toFixed(2) : selectedPlan.monthlyPrice}</span>
              <span class="ml-1">/month</span>
              {isAnnual && <span class="ml-2 text-sm">Billed annually (${selectedPlan.annualPrice})</span>}
            </div>
          </div>
          
          <div class="p-6">
            <div class="mb-8">
              <h3 class="font-semibold text-lg mb-4">Plan Features:</h3>
              <ul class="space-y-2">
                {selectedPlan.features.map(feature => (
                  <li class="flex items-start">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-green-500 mr-3 flex-shrink-0 mt-0.5">
                      <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" />
                    </svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
            
            <div id="checkout-form">
              <h3 class="font-semibold text-lg mb-4">Payment Information</h3>
              <div class="space-y-4">
                <div>
                  <label for="name" class="block text-sm font-medium text-neutral-700 mb-1">Name on Card</label>
                  <input type="text" id="name" class="w-full px-4 py-2 border border-neutral-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors" />
                </div>
                
                <div>
                  <label for="email" class="block text-sm font-medium text-neutral-700 mb-1">Email Address</label>
                  <input type="email" id="email" class="w-full px-4 py-2 border border-neutral-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors" />
                </div>
                
                <div>
                  <label for="card" class="block text-sm font-medium text-neutral-700 mb-1">Card Information</label>
                  <div id="card-element" class="w-full px-4 py-3 border border-neutral-300 rounded-lg">
                    <!-- Stripe Card Element will be inserted here -->
                    <div class="h-6 flex items-center text-neutral-500">
                      <span>Card details will appear here when Stripe is connected</span>
                    </div>
                  </div>
                </div>
                
                <div id="card-errors" class="text-red-500 text-sm"></div>
                
                <div class="mt-6">
                  <Button id="submit-payment" variant="primary" fullWidth={true}>
                    Pay ${price} for {isAnnual ? 'Annual' : 'Monthly'} Subscription
                  </Button>
                </div>
                
                <p class="text-sm text-neutral-500 text-center mt-4">
                  By completing this purchase, you agree to our <a href="#" class="text-primary-500 hover:text-primary-600">Terms of Service</a> and authorize us to charge your card for this purchase and future payments in accordance with our terms.
                </p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="text-center mt-8">
          <a href="/" class="text-neutral-600 hover:text-neutral-800 inline-flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 mr-1">
              <path fill-rule="evenodd" d="M7.72 12.53a.75.75 0 0 1 0-1.06l7.5-7.5a.75.75 0 1 1 1.06 1.06L9.31 12l6.97 6.97a.75.75 0 1 1-1.06 1.06l-7.5-7.5Z" clip-rule="evenodd" />
            </svg>
            Return to Home Page
          </a>
        </div>
      </div>
    </Container>
  </div>
</Layout>

<script define:vars={{ selectedPlan, price, interval, plan, billing }}>
  // This is where Stripe integration would be implemented
  document.addEventListener('DOMContentLoaded', () => {
    const submitButton = document.getElementById('submit-payment');
    
    if (submitButton) {
      submitButton.addEventListener('click', (e) => {
        e.preventDefault();
        
        // In a real implementation, this would use the Stripe JavaScript SDK
        // to create a payment method and submit to your server
        
        const nameInput = document.getElementById('name');
        const emailInput = document.getElementById('email');
        
        if (!nameInput.value || !emailInput.value) {
          const errorElement = document.getElementById('card-errors');
          errorElement.textContent = 'Please fill out all required fields.';
          return;
        }
        
        // Change button state
        submitButton.disabled = true;
        submitButton.textContent = 'Processing...';
        
        // For demo purposes, simulate a successful payment
        setTimeout(() => {
          // Redirect to success page
          window.location.href = `/success?plan=${plan}&billing=${billing}`;
        }, 2000);
      });
    }
  });
</script>