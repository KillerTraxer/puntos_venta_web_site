---
import Layout from '../layouts/Layout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';

// Get URL parameters
const { plan = 'starter', billing = 'monthly' } = Astro.url.searchParams;

// Define plan details
const plans = {
  starter: {
    name: 'Starter',
    features: [
      '1 POS Terminal',
      'Basic Inventory Management',
      'Email Support',
      'Sales Reports'
    ]
  },
  professional: {
    name: 'Professional',
    features: [
      '3 POS Terminals',
      'Advanced Inventory Management',
      'Customer Management',
      'Priority Email & Chat Support',
      'Advanced Analytics & Reports'
    ]
  },
  enterprise: {
    name: 'Enterprise',
    features: [
      'Unlimited POS Terminals',
      'Enterprise Inventory Management',
      'Custom Integrations',
      '24/7 Priority Support',
      'Dedicated Account Manager'
    ]
  }
};

// Get the selected plan
const selectedPlan = plans[plan] || plans.starter;
const isAnnual = billing === 'annual';

// Generate random order number
const orderNumber = 'POS-' + Math.floor(Math.random() * 10000).toString().padStart(4, '0');

// Meta information
const title = `Thank You for Your Purchase | POSPro`;
const description = `Your purchase of the ${selectedPlan.name} plan has been completed. Get started with POSPro today.`;
---

<Layout title={title} description={description}>
  <div class="py-16 md:py-24 bg-gray-50">
    <Container narrow={true}>
      <div class="max-w-2xl mx-auto text-center">
        <div class="mb-8 flex justify-center">
          <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-10 h-10 text-green-500">
              <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>
        
        <h1 class="text-3xl md:text-4xl font-bold mb-4">Thank You for Your Purchase!</h1>
        <p class="text-lg text-neutral-600 mb-8">Your order has been successfully processed and your subscription is now active.</p>
        
        <div class="bg-white rounded-xl shadow-sm p-8 mb-8">
          <h2 class="text-xl font-semibold mb-4">Order Summary</h2>
          <div class="space-y-4">
            <div class="flex justify-between py-2 border-b border-neutral-200">
              <span class="font-medium">Order Number:</span>
              <span>{orderNumber}</span>
            </div>
            <div class="flex justify-between py-2 border-b border-neutral-200">
              <span class="font-medium">Plan:</span>
              <span>{selectedPlan.name}</span>
            </div>
            <div class="flex justify-between py-2 border-b border-neutral-200">
              <span class="font-medium">Billing Cycle:</span>
              <span>{isAnnual ? 'Annual' : 'Monthly'}</span>
            </div>
          </div>
        </div>
        
        <div class="space-y-6">
          <h2 class="text-xl font-semibold">What's Next?</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-white p-6 rounded-lg shadow-sm">
              <div class="bg-primary-100 rounded-full w-12 h-12 flex items-center justify-center mb-4 mx-auto">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-600">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                </svg>
              </div>
              <h3 class="font-semibold text-center mb-2">Check Your Email</h3>
              <p class="text-sm text-neutral-600 text-center">You'll receive a confirmation email with your account details.</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow-sm">
              <div class="bg-primary-100 rounded-full w-12 h-12 flex items-center justify-center mb-4 mx-auto">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-600">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                </svg>
              </div>
              <h3 class="font-semibold text-center mb-2">Set Up Your Account</h3>
              <p class="text-sm text-neutral-600 text-center">Complete your profile and customize your POS settings.</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow-sm">
              <div class="bg-primary-100 rounded-full w-12 h-12 flex items-center justify-center mb-4 mx-auto">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-600">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                </svg>
              </div>
              <h3 class="font-semibold text-center mb-2">Explore Documentation</h3>
              <p class="text-sm text-neutral-600 text-center">Learn how to make the most of your new POS system.</p>
            </div>
          </div>
          
          <div class="mt-8 space-x-4">
            <Button href="/dashboard" variant="primary">
              Go to Dashboard
            </Button>
            <Button href="/" variant="secondary">
              Return to Home
            </Button>
          </div>
        </div>
      </div>
    </Container>
  </div>
</Layout>